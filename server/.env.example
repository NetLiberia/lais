# Copy to server/.env and adjust. Never commit the real .env file.
NODE_ENV=development
PORT=4000

# PostgreSQL 15+ with PostGIS 3.x. The database must already exist.
DATABASE_URL=postgres://lais_owner:CHANGE_ME@localhost:5432/lais
DATABASE_POOL_MAX=10

# 64 hex characters (32 bytes) used to encrypt MFA secrets at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=

# When true, privileged roles (admin, registrar, supervisor, auditor) must enrol in TOTP MFA.
MFA_ENFORCED=false

SESSION_IDLE_MINUTES=30
SESSION_ABSOLUTE_HOURS=8

# Private document storage. Must be outside any web-served directory.
DOCUMENT_STORAGE_DIR=storage/documents
MAX_UPLOAD_BYTES=10485760
# Administrator-initiated backups. PG_DUMP_PATH is the full path to pg_dump(.exe) if it is not on PATH,
# e.g. C:\Program Files\PostgreSQL\18\bin\pg_dump.exe. Keep BACKUP_DIR outside any web-served folder.
PG_DUMP_PATH=
BACKUP_DIR=storage/backups

# Number of reverse proxies (e.g. nginx) in front of the API. Leave 0 when clients connect directly.
TRUST_PROXY=0

# Days a landowner can download documents released to them after approval.
DOCUMENT_RELEASE_DAYS=30

# Spatial conflict thresholds. Placeholders until the cadastral authority sets official tolerances.
OVERLAP_TOLERANCE_M2=1
DUPLICATE_HAUSDORFF_M=2
MIN_PARCEL_AREA_M2=10
COVERAGE_TOLERANCE_M2=1
SIGNIFICANT_BOUNDARY_CHANGE_M=5
SIGNIFICANT_AREA_CHANGE_PCT=10

# Password given to every synthetic seed account. Required by `npm run db:seed`.
SEED_PASSWORD=

# Only for `npm test` integration tests. Use a separate, disposable database: tests drop and recreate its schemas.
TEST_DATABASE_URL=
# Optional target for `npm run backup:verify` (restore test). Defaults to TEST_DATABASE_URL. Never the live database.
RESTORE_CHECK_DATABASE_URL=
