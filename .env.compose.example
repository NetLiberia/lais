# Copy to .env (in this folder) for docker compose. Never commit .env.
# Database password for the lais_owner account inside the db container.
POSTGRES_PASSWORD=
# 64 hex characters. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MFA_ENCRYPTION_KEY=
# Password given to every synthetic demo account by the seed step (12+ characters).
SEED_PASSWORD=
MFA_ENFORCED=false
